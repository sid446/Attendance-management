    "fix:article-excess": "cross-env NODE_OPTIONS=\"--require ./dns-patch.js --dns-result-order=ipv4first\" tsx --env-file=.env.local scripts/recalculate-article-attendance-excess.ts",
    "backfill:late-checkin-rules:dry": "cross-env NODE_OPTIONS=\"--require ./dns-patch.js --dns-result-order=ipv4first\" tsx --env-file=.env.local scripts/backfill-late-checkin-rules.ts --dry-run",
